# Copie este arquivo para ".env" e preencha. O ".env" NUNCA deve ir para o Git.
# Regra do projeto: somente modelos GRATUITOS do OpenRouter (limite de ~50 requisições por dia).

# --- LLM (OpenRouter) ---
OPENROUTER_API_KEY=coloque_sua_chave_aqui
LLM_MODEL=openrouter/free

# --- Embeddings (use sempre um modelo terminado em ":free") ---
EMBEDDINGS_MODEL=nvidia/nemotron-3-embed-1b:free

# --- Langfuse (opcional: observabilidade) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=

# --- Servidor MCP (versão completa do projeto) ---
MCP_URL=http://127.0.0.1:8000/mcp

# --- Experimentos ---
# Defina como 1 para forçar um STATE_VERSION_CONFLICT na primeira tentativa
SIMULAR_CONFLITO=
